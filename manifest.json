{
    "manifest_version": 3,
    "name": "Student Academic Insights",
    "version": "1.0.0",
    "description": "Calculates SGPA and CGPA from the IIIT Kurnool AIMS Course History page.",

    "permissions": [],

    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },

    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png"
        }
    },

    "content_scripts": [
        {
            "matches": [
                "https://aims.iiitk.ac.in/aimskurnool/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "style.css"
            ],
            "run_at": "document_idle"
        }
    ]
}